# ──────────────────────────────────────────────
# Awarely — Environment Variables Template
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────

# ── Firebase Client Configuration ─────────────
# These values are NOT secrets — they are restricted
# by Firestore Security Rules, Firebase Auth, and
# API key HTTP referrer restrictions.
# Find these in Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Geoapify (Geocoding & Autocomplete) ──────────────────────
# Free tier: 3,000 requests/day. Register at https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=

# ── Cartography & Tile Providers (Leaflet) ────────────────────
# By default, Awarely uses OpenStreetMap tiles (https://tile.openstreetmap.org/{z}/{x}/{y}.png).
# For production deployments with higher volume or custom dark basemaps, configure one of:
# Option A: Custom / Self-hosted Tile Provider
# VITE_MAP_TILE_URL=https://{s}.example.com/tiles/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Option B: CARTO Basemaps (Requires free/commercial CARTO API Key)
# VITE_CARTO_API_KEY=
# VITE_CARTO_THEME=voyager              # voyager (default street map), dark_all (Dark Matter), light_all (Positron)
# Option C: Geoapify Raster Tiles (NOTE: consumes 0.25 credits/tile from your 3,000/day pool)
# VITE_USE_GEOAPIFY_TILES=false

# ── Legacy Google Maps (Deprecated) ───────────────────────────
# Superseded by Leaflet + Geoapify (Phase 1 & Phase 2).
# VITE_GOOGLE_MAPS_API_KEY=

# ── Application Environment ────────────────────
# "development" → connects to Firebase Emulator Suite
# "production"  → connects to live Firebase project
VITE_APP_ENV=development


# ══════════════════════════════════════════════
#  SERVER-SIDE SECRETS (Cloud Functions only)
#  These NEVER appear as VITE_ variables.
#  Configure these in Google Cloud Secret Manager
#  or in functions/.env for local emulator testing.
# ══════════════════════════════════════════════

# Gemini API Key — server-side only via Secret Manager
# GEMINI_API_KEY=                   # DO NOT put here — Cloud Secret Manager only

# Server-side Google Maps Geocoding API Key — IP-restricted
# MAPS_SERVER_API_KEY=              # DO NOT put here — Cloud Secret Manager only

# SendGrid API Key — for trusted circle email notifications
# SENDGRID_API_KEY=                 # DO NOT put here — Cloud Secret Manager only
